include README.md QUICK_START.md SECURITY.md CONTRIBUTING.md CHANGELOG.md pyproject.toml requirements.txt
include run.py bootstrap.py start.bat start.sh cloud-threat-investigation.code-workspace
include .env.example .gitignore
recursive-include src *.py *.json *.jsonl *.html *.css *.js
recursive-include tests *.py
recursive-include scripts *.py *.mjs
recursive-include docs *.md
recursive-include .vscode *.json
recursive-include .github *.yml
prune workspace
prune runs
prune build
prune dist
global-exclude __pycache__ *.pyc *.pem *.key *.p12 *.pfx
