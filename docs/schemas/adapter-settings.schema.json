{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CloudTrail / OCSF adapter settings",
  "type": "object",
  "properties": {
    "tenant": {
      "type": "string",
      "minLength": 1
    },
    "expected_regions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "public_resources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "large_read_bytes": {
      "type": "integer",
      "minimum": 1,
      "default": 104857600
    },
    "include_failed": {
      "type": "boolean",
      "default": true
    },
    "principal_aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "description": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
